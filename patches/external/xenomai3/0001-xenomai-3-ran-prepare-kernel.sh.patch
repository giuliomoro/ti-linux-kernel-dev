+	a4l_dbg(1, drv_dbg, dev, "mio_common: serial subdevice registered\n");
+
+	/* RTSI */
+	subd = a4l_alloc_subd(0, NULL);
+	if(subd == NULL)
+		return -ENOMEM;
+
+#if 1 /* TODO: add RTSI subdevice */
+	subd->flags = A4L_SUBD_UNUSED;
