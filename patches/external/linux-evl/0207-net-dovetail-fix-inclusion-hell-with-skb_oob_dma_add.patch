From 1028ebb377247ef7e941e18f55dbdd9744da479c Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Tue, 24 Jun 2025 23:11:40 +0200
Subject: [PATCH 0207/1013] net: dovetail: fix inclusion hell with
 skb_oob_dma_addr()

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 include/linux/skbuff.h | 23 +----------------------
 net/core/skbuff.c      | 24 +++++++++++++++++++++++-
 2 files changed, 24 insertions(+), 23 deletions(-)

diff --git a/include/linux/skbuff.h b/include/linux/skbuff.h
index d0ee34964484..0808b27b8c31 100644
--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -5258,7 +5258,6 @@ ssize_t skb_splice_from_iter(struct sk_buff *skb, struct iov_iter *iter,
 #ifdef CONFIG_NET_OOB
 
 #include <net/page_pool/helpers.h>
-#include <linux/skbuff_ref.h>
 
 extern unsigned int sysctl_max_oob_skb;
 
@@ -5330,27 +5329,7 @@ static inline struct skb_shared_oob *skb_shinfo_oob(struct sk_buff *skb)
 	return &skb_shinfo(skb)->oob_shinfo;
 }
 
-/**
- * skb_oob_dma_addr - Return the DMA address of a pre-mapped buffer
- * obtained from an oob pool.
- *
- * DMA_MAPPING_ERROR is returned if the skb is dataless, or its
- * storage area does not belong to an oob page pool.
- */
-static inline dma_addr_t skb_oob_dma_addr(const struct sk_buff *skb)
-{
-	struct page *page = skb->head ? virt_to_page(skb->head) : NULL;
-	struct page_pool *pool;
-
-	if (!page)
-		return DMA_MAPPING_ERROR;
-
-	pool = napi_pp_get_pool(page_to_netmem(page));
-	if (!pool || !page_pool_is_oob(pool))
-		return DMA_MAPPING_ERROR;
-
-	return page_pool_get_dma_addr(page);
-}
+dma_addr_t skb_oob_dma_addr(const struct sk_buff *skb);
 
 bool skb_release_oob(struct sk_buff *skb);
 void free_skb_oob(struct sk_buff *skb);
diff --git a/net/core/skbuff.c b/net/core/skbuff.c
index 9b7c7081f7fa..5183aa9f0a10 100644
--- a/net/core/skbuff.c
+++ b/net/core/skbuff.c
@@ -50,7 +50,6 @@
 #include <net/pkt_sched.h>
 #endif
 #include <linux/string.h>
-#include <linux/skbuff.h>
 #include <linux/skbuff_ref.h>
 #include <linux/splice.h>
 #include <linux/cache.h>
@@ -675,6 +674,29 @@ void put_oob_skb(struct sk_buff *skb)
 }
 EXPORT_SYMBOL(put_oob_skb);
 
+/**
+ * skb_oob_dma_addr - Return the DMA address of a pre-mapped buffer
+ * obtained from an oob pool.
+ *
+ * DMA_MAPPING_ERROR is returned if the skb is dataless, or its
+ * storage area does not belong to an oob page pool.
+ */
+dma_addr_t skb_oob_dma_addr(const struct sk_buff *skb)
+{
+	struct page *page = skb->head ? virt_to_page(skb->head) : NULL;
+	struct page_pool *pool;
+
+	if (!page)
+		return DMA_MAPPING_ERROR;
+
+	pool = napi_pp_get_pool(page_to_netmem(page));
+	if (!pool || !page_pool_is_oob(pool))
+		return DMA_MAPPING_ERROR;
+
+	return page_pool_get_dma_addr(page);
+}
+EXPORT_SYMBOL(skb_oob_dma_addr);
+
 #else  /* !CONFIG_NET_OOB */
 
 static inline void init_oob_cache(void)
-- 
