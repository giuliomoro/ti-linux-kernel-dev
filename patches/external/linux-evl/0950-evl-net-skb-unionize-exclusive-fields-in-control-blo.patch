From 7f2607bcde638803be1e7eaa40b3856010d04141 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <philippe.gerum@exail.com>
Date: Fri, 2 May 2025 11:01:37 +0200
Subject: [PATCH 0950/1010] evl/net: skb: unionize exclusive fields in control
 block

Signed-off-by: Philippe Gerum <philippe.gerum@exail.com>
---
 include/evl/net/skb.h | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/include/evl/net/skb.h b/include/evl/net/skb.h
index 9103292f24..593ac75948 100644
--- a/include/evl/net/skb.h
+++ b/include/evl/net/skb.h
@@ -20,9 +20,11 @@ struct evl_socket;
 struct iovec;
 
 struct evl_net_cb {
-	struct evl_net_handler *handler;
-	struct evl_socket *tracker;
 	struct net_device *dev;
+	union {
+		struct evl_net_handler *handler;
+		struct evl_socket *tracker;
+	};
 	union {
 		/* protocol-specific stuff should live here. */
 	};
-- 
