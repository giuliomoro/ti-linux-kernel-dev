 drivers/net/ethernet/intel/igb/igb.h         |  63 +-
 drivers/net/ethernet/intel/igb/igb_ethtool.c |   8 +-
 drivers/net/ethernet/intel/igb/igb_main.c    | 625 +++++++++++++++----
 drivers/net/ethernet/intel/igb/igb_ptp.c     |  58 +-
 5 files changed, 616 insertions(+), 147 deletions(-)

