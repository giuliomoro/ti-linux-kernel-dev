new file mode 100644
index 000000000..a304f311a
--- /dev/null
+++ b/drivers/xenomai/net/drivers/tulip/media.c
@@ -0,0 +1,569 @@
+/*
+	drivers/net/tulip/media.c
+
+	Maintained by Jeff Garzik <jgarzik@mandrakesoft.com>
