From 79bc9ba775b058a0b457aa8b900c68645c381507 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Fri, 25 Aug 2017 08:49:26 +0200
Subject: [PATCH 050/985] drivers: irqchip: irq_pipeline: advertise immediate
 readiness

These irqchip drivers require no change in order to support the
pipelined interrupt model. Just turn on the IRQ_PIPELINE_SAFE bit into
their flags to advertise the capability.

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 drivers/base/regmap/regmap-irq.c                  | 1 +
 drivers/gpio/gpio-davinci.c                       | 3 ++-
 drivers/gpio/gpio-mxc.c                           | 3 ++-
 drivers/gpio/gpio-pca953x.c                       | 2 +-
 drivers/gpio/gpio-zynq.c                          | 4 ++--
 drivers/gpu/ipu-v3/ipu-common.c                   | 1 +
 drivers/iio/industrialio-trigger.c                | 1 +
 drivers/irqchip/irq-bcm2836.c                     | 3 +++
 drivers/irqchip/irq-gic-v2m.c                     | 1 +
 drivers/irqchip/irq-gic-v3-its-fsl-mc-msi.c       | 3 ++-
 drivers/irqchip/irq-gic-v3.c                      | 6 ++++--
 drivers/irqchip/irq-sun4i.c                       | 2 +-
 drivers/irqchip/irq-sunxi-nmi.c                   | 2 +-
 drivers/mfd/tps65217.c                            | 1 +
 drivers/pci/controller/dwc/pcie-designware-host.c | 1 +
 drivers/pci/msi/irqdomain.c                       | 4 ++--
 drivers/soc/qcom/smp2p.c                          | 1 +
 drivers/soc/ti/ti_sci_inta_msi.c                  | 1 +
 18 files changed, 28 insertions(+), 12 deletions(-)

diff --git a/drivers/base/regmap/regmap-irq.c b/drivers/base/regmap/regmap-irq.c
index ff7d0b14a..75362b778 100644
--- a/drivers/base/regmap/regmap-irq.c
+++ b/drivers/base/regmap/regmap-irq.c
@@ -299,6 +299,7 @@ static const struct irq_chip regmap_irq_chip = {
 	.irq_enable		= regmap_irq_enable,
 	.irq_set_type		= regmap_irq_set_type,
 	.irq_set_wake		= regmap_irq_set_wake,
+	.flags			= IRQCHIP_PIPELINE_SAFE,
 };
 
 static inline int read_sub_irq_data(struct regmap_irq_chip_data *data,
diff --git a/drivers/gpio/gpio-davinci.c b/drivers/gpio/gpio-davinci.c
index 76b58c70b..59ea61174 100644
--- a/drivers/gpio/gpio-davinci.c
+++ b/drivers/gpio/gpio-davinci.c
@@ -291,7 +291,8 @@ static struct irq_chip gpio_irqchip = {
 	.irq_unmask	= gpio_irq_unmask,
 	.irq_mask	= gpio_irq_mask,
 	.irq_set_type	= gpio_irq_type,
-	.flags		= IRQCHIP_SET_TYPE_MASKED | IRQCHIP_SKIP_SET_WAKE,
+	.flags		= IRQCHIP_SET_TYPE_MASKED | IRQCHIP_SKIP_SET_WAKE |
+			  IRQCHIP_PIPELINE_SAFE,
 };
 
 static void gpio_irq_handler(struct irq_desc *desc)
diff --git a/drivers/gpio/gpio-mxc.c b/drivers/gpio/gpio-mxc.c
index 619b6fb9d..81b06dc74 100644
--- a/drivers/gpio/gpio-mxc.c
+++ b/drivers/gpio/gpio-mxc.c
@@ -365,7 +365,8 @@ static int mxc_gpio_init_gc(struct mxc_gpio_port *port, int irq_base)
 	ct->chip.irq_unmask = irq_gc_mask_set_bit;
 	ct->chip.irq_set_type = gpio_set_irq_type;
 	ct->chip.irq_set_wake = gpio_set_wake_irq;
-	ct->chip.flags = IRQCHIP_MASK_ON_SUSPEND | IRQCHIP_ENABLE_WAKEUP_ON_SUSPEND;
+	ct->chip.flags = IRQCHIP_MASK_ON_SUSPEND |
+		IRQCHIP_ENABLE_WAKEUP_ON_SUSPEND | IRQCHIP_PIPELINE_SAFE;
 	ct->regs.ack = GPIO_ISR;
 	ct->regs.mask = GPIO_IMR;
 
diff --git a/drivers/gpio/gpio-pca953x.c b/drivers/gpio/gpio-pca953x.c
index bb7c1bf5f..ba6514f3e 100644
--- a/drivers/gpio/gpio-pca953x.c
+++ b/drivers/gpio/gpio-pca953x.c
@@ -827,7 +827,7 @@ static const struct irq_chip pca953x_irq_chip = {
 	.irq_set_type		= pca953x_irq_set_type,
 	.irq_shutdown		= pca953x_irq_shutdown,
 	.irq_print_chip		= pca953x_irq_print_chip,
-	.flags			= IRQCHIP_IMMUTABLE,
+	.flags			= IRQCHIP_IMMUTABLE | IRQCHIP_PIPELINE_SAFE,
 	GPIOCHIP_IRQ_RESOURCE_HELPERS,
 };
 
diff --git a/drivers/gpio/gpio-zynq.c b/drivers/gpio/gpio-zynq.c
index cc53e6940..ecbf49b59 100644
--- a/drivers/gpio/gpio-zynq.c
