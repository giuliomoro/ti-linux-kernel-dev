+++ b/drivers/xenomai/analogy/rtdm_interface.c
@@ -0,0 +1,308 @@
+/*
+ * Analogy for Linux, user interface (open, read, write, ioctl, proc)
+ *
+ * Copyright (C) 1997-2000 David A. Schleef <ds@schleef.org>
