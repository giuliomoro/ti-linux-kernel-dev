+		return 0;
+	}
+
+	if (p->key < NET_HASH_TBL_SIZE)
+		xnvfile_printf(it,
+			       "%02X\t%u.%u.%u.%-3u\t%u.%u.%u.%-3u"
+			       "\t\t%u.%u.%u.%-3u\n",
+			       p->key, NIPQUAD(p->dest_net_ip),
+			       NIPQUAD(p->dest_net_mask), NIPQUAD(p->gw_ip));
+	else
+		xnvfile_printf(it,
+			       "*\t%u.%u.%u.%-3u\t%u.%u.%u.%-3u\t\t"
+			       "%u.%u.%u.%-3u\n",
+			       NIPQUAD(p->dest_net_ip),
+			       NIPQUAD(p->dest_net_mask), NIPQUAD(p->gw_ip));
+
+	return 0;
+}
