From 8b8af1f3831138828f803a51e03f692bf5ac70d3 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <philippe.gerum@exail.com>
Date: Sun, 27 Apr 2025 15:44:17 +0200
Subject: [PATCH 0213/1010] net: fec: leave stage exclusion on TX to stack

Signed-off-by: Philippe Gerum <philippe.gerum@exail.com>
---
 drivers/net/ethernet/freescale/fec_main.c | 13 -------------
 1 file changed, 13 deletions(-)

diff --git a/drivers/net/ethernet/freescale/fec_main.c b/drivers/net/ethernet/freescale/fec_main.c
index 87a5b555f0..635440e837 100644
--- a/drivers/net/ethernet/freescale/fec_main.c
+++ b/drivers/net/ethernet/freescale/fec_main.c
@@ -1030,17 +1030,6 @@ fec_enet_start_xmit(struct sk_buff *skb, struct net_device *ndev)
 	txq = fep->tx_queue[queue];
 	nq = netdev_get_tx_queue(ndev, queue);
 
-	/*
-	 * Lock out any sender running from the alternate execution
-	 * stage from any CPU (i.e. oob vs in-band). Clearly, in-band
-	 * tasks should refrain from sending output through an
-	 * oob-enabled device when aiming at the lowest possible
-	 * latency for the oob players, but we still allow shared use
-	 * for flexibility though, which comes in handy when a single
-	 * NIC only is available to convey both kinds of traffic.
-	 */
-	netif_tx_lock_oob(nq);
-
 	if (skb_is_gso(skb))
 		ret = fec_enet_txq_submit_tso(txq, skb, ndev);
 	else
@@ -1052,8 +1041,6 @@ fec_enet_start_xmit(struct sk_buff *skb, struct net_device *ndev)
 			netif_tx_stop_queue(nq);
 	}
 
-	netif_tx_unlock_oob(nq);
-
 	return ret;
 }
 
