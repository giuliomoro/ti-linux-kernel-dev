From 9dc0e2c655249c3bf7047e769da7fe902bb43d6a Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Wed, 21 Dec 2022 18:22:31 +0100
Subject: [PATCH 0808/1013] evl/factory: constify dev argument to devnode cb

As required since the v6.2 development cycle.

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 kernel/evl/factory.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/kernel/evl/factory.c b/kernel/evl/factory.c
index 1966f50ef2af..a17850c165d1 100644
--- a/kernel/evl/factory.c
+++ b/kernel/evl/factory.c
@@ -844,7 +844,7 @@ bool evl_may_access_factory(struct evl_factory *fac)
 }
 EXPORT_SYMBOL_GPL(evl_may_access_factory);
 
-static char *evl_devnode(struct device *dev, umode_t *mode)
+static char *evl_devnode(const struct device *dev, umode_t *mode)
 {
 	return kasprintf(GFP_KERNEL, "evl/%s", dev_name(dev));
 }
