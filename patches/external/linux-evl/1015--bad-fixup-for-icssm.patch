@@ -782,7 +764,6 @@ static int icssm_prueth_sw_insert_fdb_entry(struct prueth_emac *emac,
 	bucket_info->bucket_entries++;
 	fdb->total_entries++;
 
-	icssm_prueth_sw_fdb_spin_unlock(fdb);
 
 	dev_dbg(prueth->dev, "added fdb: %pM port=%d total_entries=%u\n",
 		mac, emac->port_id, fdb->total_entries);
@@ -819,7 +800,6 @@ static int icssm_prueth_sw_delete_fdb_entry(struct prueth_emac *emac,
 	mac_tbl_idx = ret;
 	mac_info = FDB_MAC_TBL_ENTRY(mac_tbl_idx);
 
