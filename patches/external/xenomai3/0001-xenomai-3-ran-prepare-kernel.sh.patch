diff --git a/include/xenomai/cobalt/kernel/heap.h b/include/xenomai/cobalt/kernel/heap.h
new file mode 100644
index 000000000..09c982f62
--- /dev/null
+++ b/include/xenomai/cobalt/kernel/heap.h
@@ -0,0 +1,172 @@
+/*
