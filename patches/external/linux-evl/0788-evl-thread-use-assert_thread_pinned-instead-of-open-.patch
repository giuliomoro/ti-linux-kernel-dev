From 090378ffbcb4c9308b027ad60effcce56145e141 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Wed, 19 Oct 2022 07:57:05 +0200
Subject: [PATCH 0788/1010] evl/thread: use assert_thread_pinned() instead of
 open code

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 kernel/evl/sched/core.c |  9 +++------
 kernel/evl/thread.c     | 12 ++++--------
 2 files changed, 7 insertions(+), 14 deletions(-)

diff --git a/kernel/evl/sched/core.c b/kernel/evl/sched/core.c
index 20c4aca843..2bfa16642f 100644
--- a/kernel/evl/sched/core.c
+++ b/kernel/evl/sched/core.c
@@ -391,8 +391,7 @@ static inline void check_cpu_affinity(struct task_struct *p)
 /* thread->lock + thread->rq->lock held, hard irqs off. */
 void evl_putback_thread(struct evl_thread *thread)
 {
-	assert_hard_lock(&thread->lock);
-	assert_hard_lock(&thread->rq->lock);
+  	assert_thread_pinned(thread);
 
 	if (thread->state & T_READY)
 		evl_dequeue_thread(thread);
@@ -412,8 +411,7 @@ int evl_set_thread_policy_locked(struct evl_thread *thread,
 	bool effective;
 	int ret;
 
-	assert_hard_lock(&thread->lock);
-	assert_hard_lock(&thread->rq->lock);
+	assert_thread_pinned(thread);
 
 	/* Check parameters early on. */
 	ret = evl_check_schedparams(sched_class, thread, p);
@@ -512,8 +510,7 @@ bool evl_set_effective_thread_priority(struct evl_thread *thread, int prio)
 {
 	int wprio = evl_calc_weighted_prio(thread->base_class, prio);
 
-	assert_hard_lock(&thread->lock);
-	assert_hard_lock(&thread->rq->lock);
+	assert_thread_pinned(thread);
 
 	thread->bprio = prio;
 	if (wprio == thread->wprio)
diff --git a/kernel/evl/thread.c b/kernel/evl/thread.c
index f83deca6fd..799195242d 100644
--- a/kernel/evl/thread.c
+++ b/kernel/evl/thread.c
@@ -503,8 +503,7 @@ void evl_sleep_on_locked(ktime_t timeout, enum evl_tmode timeout_mode,
 	/* Sleeping while preemption is disabled is a bug. */
 	EVL_WARN_ON(CORE, evl_preempt_count() != 0);
 
-	assert_hard_lock(&curr->lock);
-	assert_hard_lock(&rq->lock);
+	assert_thread_pinned(curr);
 
 	trace_evl_sleep_on(timeout, timeout_mode, clock, wchan);
 
@@ -581,8 +580,7 @@ static void evl_wakeup_thread_locked(struct evl_thread *thread,
 	struct evl_rq *rq = thread->rq;
 	unsigned long oldstate;
 
-	assert_hard_lock(&thread->lock);
-	assert_hard_lock(&thread->rq->lock);
+	assert_thread_pinned(thread);
 
 	if (EVL_WARN_ON(CORE, mask & ~(T_DELAY|T_PEND|T_WAIT)))
 		return;
@@ -684,8 +682,7 @@ static void evl_release_thread_locked(struct evl_thread *thread,
 	struct evl_rq *rq = thread->rq;
 	unsigned long oldstate;
 
-	assert_hard_lock(&thread->lock);
-	assert_hard_lock(&thread->rq->lock);
+	assert_thread_pinned(thread);
 
 	if (EVL_WARN_ON(CORE, mask & ~(T_SUSP|T_HALT|T_INBAND|T_DORMANT|T_PTSYNC)))
 		return;
@@ -1970,8 +1967,7 @@ static int set_time_slice(struct evl_thread *thread, ktime_t quantum)
 {
 	struct evl_rq *rq = thread->rq;
 
-	assert_hard_lock(&thread->lock);
-	assert_hard_lock(&rq->lock);
+	assert_thread_pinned(thread);
 
 	thread->rrperiod = quantum;
 
-- 
