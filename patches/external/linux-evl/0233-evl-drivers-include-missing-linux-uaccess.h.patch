From c95bdba67b6646f99808b9915912d31d6ead16fd Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Mon, 28 Jan 2019 15:35:50 +0100
Subject: [PATCH 0233/1013] evl/drivers: include missing linux/uaccess.h

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 drivers/evenless/hectic.c | 1 +
 drivers/evenless/latmus.c | 1 +
 2 files changed, 2 insertions(+)

diff --git a/drivers/evenless/hectic.c b/drivers/evenless/hectic.c
index 1bb352b8fc74..11cf34c28c27 100644
--- a/drivers/evenless/hectic.c
+++ b/drivers/evenless/hectic.c
@@ -11,6 +11,7 @@
 #include <linux/module.h>
 #include <linux/vmalloc.h>
 #include <linux/slab.h>
+#include <linux/uaccess.h>
 #include <linux/semaphore.h>
 #include <linux/irq_work.h>
 #include <evenless/synch.h>
diff --git a/drivers/evenless/latmus.c b/drivers/evenless/latmus.c
index de6e1dea8b4b..35cf283fcd7f 100644
--- a/drivers/evenless/latmus.c
+++ b/drivers/evenless/latmus.c
@@ -14,6 +14,7 @@
 #include <linux/cdev.h>
 #include <linux/fs.h>
 #include <linux/fcntl.h>
+#include <linux/uaccess.h>
 #include <evenless/file.h>
 #include <evenless/wait.h>
 #include <evenless/clock.h>
