diff --git a/include/xenomai/cobalt/kernel/registry.h b/include/xenomai/cobalt/kernel/registry.h
new file mode 100644
index 000000000..a459da503
--- /dev/null
+++ b/include/xenomai/cobalt/kernel/registry.h
@@ -0,0 +1,202 @@
+/*
