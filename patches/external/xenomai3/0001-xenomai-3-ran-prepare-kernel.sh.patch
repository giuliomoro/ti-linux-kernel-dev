+		     const struct __kernel_timespec __user *u_ts,
+		     int __user *u_ret));
+
+COBALT_SYSCALL_DECL(monitor_destroy,
+		    (struct cobalt_monitor_shadow __user *u_monsh));
+
+void cobalt_monitor_reclaim(struct cobalt_resnode *node,
+			    spl_t s);
+
+#endif /* !_COBALT_POSIX_MONITOR_H */
diff --git a/kernel/xenomai/posix/mqueue.c b/kernel/xenomai/posix/mqueue.c
new file mode 100644
index 000000000..34776fe6c
--- /dev/null
+++ b/kernel/xenomai/posix/mqueue.c
@@ -0,0 +1,1088 @@
+/*
+ * Written by Gilles Chanteperdrix <gilles.chanteperdrix@xenomai.org>.
+ *
