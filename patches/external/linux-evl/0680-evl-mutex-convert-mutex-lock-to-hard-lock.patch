-	evl_spin_lock(&mutex->lock);
+	raw_spin_lock(&mutex->lock);
 
 	owner = mutex->owner;
 	if (owner == originator) {
@@ -996,7 +996,7 @@ int evl_reorder_mutex_wait(struct evl_thread *waiter,
 	list_add_priff(waiter, &mutex->wchan.wait_list, wprio, wait_next);
 
