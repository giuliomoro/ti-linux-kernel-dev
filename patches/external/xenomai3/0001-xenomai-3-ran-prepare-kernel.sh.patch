+	pid_t pid;
+	int state;
+	char name[XNOBJECT_NAME_LEN];
+	unsigned long ssw;
+	unsigned long csw;
+	unsigned long xsc;
+	unsigned long pf;
+	xnticks_t exectime_period;
+	xnticks_t account_period;
+	xnticks_t exectime_total;
+	struct xnsched_class *sched_class;
+	xnticks_t period;
+	int cprio;
+};
