+	struct ni_gpct *counter = (struct ni_gpct *)subd->priv;
+
+	a4l_ni_tio_cancel(counter);
+	ni_e_series_enable_second_irq(dev, counter->counter_index, 0);
+	ni_release_gpct_mite_channel(dev, counter->counter_index);
+}
