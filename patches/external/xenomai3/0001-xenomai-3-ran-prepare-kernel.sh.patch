+
+COBALT_SYSCALL_DECL(event_inquire,
+		    (struct cobalt_event_shadow __user *u_event,
+		     struct cobalt_event_info __user *u_info,
+		     pid_t __user *u_waitlist,
+		     size_t waitsz));
+
