+#define DEV_ADDR_LEN 32 /* avoids inconsistent MAX_ADDR_LEN */
+
+struct rtnet_ioctl_head {
+	char if_name[IFNAMSIZ];
+};
+
+struct rtnet_core_cmd {
+	struct rtnet_ioctl_head head;
+
+	union {
+		/*** rtifconfig **/
+		struct {
+			__u32 ip_addr;
+			__u32 broadcast_ip;
+			__u32 set_dev_flags;
+			__u32 clear_dev_flags;
+			__u32 dev_addr_type;
+			__u32 __padding;
+			__u8 dev_addr[DEV_ADDR_LEN];
+		} up;
+
