+ * copied to this memory area.
+ *
+ * @return The memory address of the object's descriptor is returned
+ * on success. Otherwise, NULL is returned if @a handle does not
+ * reference a registered object.
+ *
+ * @coretags{unrestricted}
+ */
+
+/** @} */
