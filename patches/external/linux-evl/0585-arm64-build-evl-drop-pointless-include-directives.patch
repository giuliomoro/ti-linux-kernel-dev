From 3334a6b53695a99fb5906d37ea8227b9b63689be Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Tue, 31 Dec 2019 12:26:20 +0100
Subject: [PATCH 0585/1010] arm64/build: evl: drop pointless include directives

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 arch/arm64/Makefile | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/arch/arm64/Makefile b/arch/arm64/Makefile
index a057820875..85a30ebae1 100644
--- a/arch/arm64/Makefile
+++ b/arch/arm64/Makefile
@@ -128,10 +128,6 @@ endif
 
 CHECKFLAGS	+= -D__aarch64__
 
-ifeq ($(CONFIG_EVL),y)
-KBUILD_CFLAGS += -Iarch/$(SRCARCH)/evl/include -Iinclude/evl
-endif
-
 ifeq ($(CONFIG_DYNAMIC_FTRACE_WITH_REGS),y)
   KBUILD_CPPFLAGS += -DCC_USING_PATCHABLE_FUNCTION_ENTRY
   CC_FLAGS_FTRACE := -fpatchable-function-entry=2
-- 
2.30.2

