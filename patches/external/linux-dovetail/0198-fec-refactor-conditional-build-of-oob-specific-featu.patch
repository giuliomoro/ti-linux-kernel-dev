 			     struct sk_buff *skb,
@@ -3645,11 +3650,7 @@ fec_enet_alloc_txq_buffers(struct net_device *ndev, unsigned int queue)
 
 		bdp = fec_enet_get_nextdesc(bdp, &txq->bd);
 
