From c072263c6e408ff2ff50f2b213a502ce83a0481b Mon Sep 17 00:00:00 2001
From: Philippe Gerum <philippe.gerum@exail.com>
Date: Wed, 18 Jun 2025 10:14:42 +0200
Subject: [PATCH 0233/1010] net: dovetail: do stricter checks in
 skb_oob_dma_addr()

Make sure the storage area carried by the skb does not belong to an
oob page pool before attempting to fetch a DMA address from its page
descriptor. In the same move, drop the check on the recycling flag
which is orthogonal to this issue.

NOTE: we still don't check whether skb->head is actually paged memory.

Signed-off-by: Philippe Gerum <philippe.gerum@exail.com>
---
 include/linux/skbuff.h | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/include/linux/skbuff.h b/include/linux/skbuff.h
index a789e8802d..16bd5bc8e5 100644
--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -5212,12 +5212,26 @@ static inline struct skb_shared_oob *skb_shinfo_oob(struct sk_buff *skb)
 	return &skb_shinfo(skb)->oob_shinfo;
 }
 
+/**
+ * skb_oob_dma_addr - Return the DMA address of a pre-mapped buffer
+ * obtained from an oob pool.
+ *
+ * DMA_MAPPING_ERROR is returned if the skb is dataless, or its
+ * storage area does not belong to an oob page pool.
+ */
 static inline dma_addr_t skb_oob_dma_addr(const struct sk_buff *skb)
 {
-	if (!skb->head || !skb_is_oob_managed(skb) || !skb->pp_recycle)
+	struct page *page = skb->head ? virt_to_page(skb->head) : NULL;
+	struct page_pool *pool;
+
+	if (!page)
+		return DMA_MAPPING_ERROR;
+
+	pool = page_pool_get_page_pool(page);
+	if (!pool || !page_pool_is_oob(pool))
 		return DMA_MAPPING_ERROR;
 
-	return page_pool_get_dma_addr(virt_to_page(skb->head));
+	return page_pool_get_dma_addr(page);
 }
 
 bool recycle_skb_oob(struct sk_buff *skb);
