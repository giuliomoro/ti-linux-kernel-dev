From 7a843a99bc9f1f03eb3ae19602d22390b57cb499 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Sun, 3 Feb 2019 18:52:44 +0100
Subject: [PATCH 0034/1013] spmi: pmic-arb: irq_pipeline: enable pipelined
 interrupt control

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 drivers/spmi/spmi-pmic-arb.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/spmi/spmi-pmic-arb.c b/drivers/spmi/spmi-pmic-arb.c
index ea843159b745..7eeee2165729 100644
--- a/drivers/spmi/spmi-pmic-arb.c
+++ b/drivers/spmi/spmi-pmic-arb.c
@@ -160,7 +160,7 @@ struct spmi_pmic_arb_bus {
 	void __iomem		*intr;
 	void __iomem		*cnfg;
 	struct spmi_controller	*spmic;
-	raw_spinlock_t		lock;
+	hard_spinlock_t		lock;
 	u16			base_apid;
 	int			apid_count;
 	u32			*mapping_table;
@@ -892,7 +892,7 @@ static struct irq_chip pmic_arb_irqchip = {
 	.irq_set_type	= qpnpint_irq_set_type,
 	.irq_set_wake	= qpnpint_irq_set_wake,
 	.irq_get_irqchip_state	= qpnpint_get_irqchip_state,
-	.flags		= IRQCHIP_MASK_ON_SUSPEND,
+	.flags		= IRQCHIP_MASK_ON_SUSPEND|IRQCHIP_PIPELINE_SAFE,
 };
 
 static int qpnpint_irq_domain_translate(struct irq_domain *d,
-- 
2.30.2

