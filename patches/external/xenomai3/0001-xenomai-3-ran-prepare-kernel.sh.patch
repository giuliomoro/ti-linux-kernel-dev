+
+#define MAX_RT_INET_PROTOCOLS 32
+
+/***
+ * transport layer protocol
+ */
+struct rtinet_protocol {
+	char *name;
+	unsigned short protocol;
+
+	struct rtsocket *(*dest_socket)(struct rtskb *);
