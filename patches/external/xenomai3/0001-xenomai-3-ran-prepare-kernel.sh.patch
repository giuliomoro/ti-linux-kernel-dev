index 000000000..88c5132b8
--- /dev/null
+++ b/drivers/xenomai/spi/spi-omap2-mcspi-rt.c
@@ -0,0 +1,1033 @@
+/**
+ * I/O handling lifted from drivers/spi/spi-omap2-mcspi.c:
+ * Copyright (C) 2019 Laurentiu-Cristian Duca
+ *  <laurentiu [dot] duca [at] gmail [dot] com>
+ * RTDM integration by:
