From fbc1fe2421b576b01cf7ec87b04fda62e42f8cf3 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Tue, 7 May 2019 14:05:46 +0200
Subject: [PATCH 0400/1010] evl/clock: silence false positive UMR warning

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 kernel/evl/clock.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/kernel/evl/clock.c b/kernel/evl/clock.c
index a6923c7aaa..5856d7bcc7 100644
--- a/kernel/evl/clock.c
+++ b/kernel/evl/clock.c
@@ -624,6 +624,7 @@ static long timerfd_oob_ioctl(struct file *filp,
 	switch (cmd) {
 	case EVL_TFDIOC_SET:
 		u_sreq = (typeof(u_sreq))arg;
+		sreq.ovalue = NULL;
 		ret = raw_copy_from_user(&sreq, u_sreq, sizeof(sreq));
 		if (ret)
 			return -EFAULT;
-- 
