diff --git a/include/xenomai/cobalt/kernel/sched-rt.h b/include/xenomai/cobalt/kernel/sched-rt.h
new file mode 100644
index 000000000..992a5ba27
--- /dev/null
+++ b/include/xenomai/cobalt/kernel/sched-rt.h
@@ -0,0 +1,150 @@
+/*
