+			"mio_common: AO subdevice not present\n");
+		subd->flags = A4L_SUBD_UNUSED;
+	}
+
+	ret = a4l_add_subd(dev, subd);
+	if(ret != NI_AO_SUBDEV)
+		return ret;
+
+	a4l_dbg(1, drv_dbg, dev, "mio_common: AO subdevice registered\n");
