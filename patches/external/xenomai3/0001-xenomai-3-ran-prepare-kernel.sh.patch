+
+	ret = a4l_add_subd(dev, subd);
+	if(ret != NI_CALIBRATION_SUBDEV)
+		return ret;
+
+	a4l_dbg(1, drv_dbg, dev, "mio_common: calib subdevice registered\n");
+
+	/* EEPROM */
