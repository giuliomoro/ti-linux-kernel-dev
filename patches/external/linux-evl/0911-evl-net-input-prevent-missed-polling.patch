From 3add9c5b593806fa444f168e69af39433e21ee7a Mon Sep 17 00:00:00 2001
From: Philippe Gerum <philippe.gerum@exail.com>
Date: Wed, 2 Apr 2025 17:14:43 +0200
Subject: [PATCH 911/985] evl/net: input: prevent missed polling

napi_poll_oob() might rechedule itself for a next run asap without
posting the wake up event of the RX thread by leaving
EVL_NETDEV_POLL_SCHED set, so don't go waiting for such event if
EVL_NETDEV_POLL_SCHED is set.

Signed-off-by: Philippe Gerum <philippe.gerum@exail.com>
---
 kernel/evl/net/input.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/kernel/evl/net/input.c b/kernel/evl/net/input.c
index 26a4048a3..d07c3566f 100644
--- a/kernel/evl/net/input.c
+++ b/kernel/evl/net/input.c
@@ -95,12 +95,13 @@ void evl_net_do_rx(void *arg)
 	est = dev->oob_state.estate;
 
 	while (!evl_kthread_should_stop()) {
-		ret = evl_wait_flag(&est->rx_flag);
-		if (ret)
-			break;
+		while (!test_bit(EVL_NETDEV_POLL_SCHED, &est->flags)) {
+			ret = evl_wait_flag(&est->rx_flag);
+			if (ret)
+				break;
+		}
 
-		if (test_bit(EVL_NETDEV_POLL_SCHED, &est->flags))
-			napi_poll_oob(est);
+		napi_poll_oob(est);
 
 		if (evl_net_move_skb_queue(&est->rx_packets, &list)) {
 			list_for_each_entry_safe(skb, next, &list, list) {
-- 
