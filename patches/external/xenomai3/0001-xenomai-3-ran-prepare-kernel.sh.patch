diff --git a/arch/arm64/xenomai/include/asm/xenomai/uapi/arith.h b/arch/arm64/xenomai/include/asm/xenomai/uapi/arith.h
new file mode 100644
index 000000000..3d81f6ea0
--- /dev/null
+++ b/arch/arm64/xenomai/include/asm/xenomai/uapi/arith.h
@@ -0,0 +1,142 @@
+/*
