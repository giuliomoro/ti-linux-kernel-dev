+
+#define driver_name "RT-ETH1394"
+
+#define pr_fmt(fmt) driver_name ": " fmt
+
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/if_arp.h>
+#include <linux/if_ether.h>
+#include <linux/ip.h>
+#include <linux/in.h>
