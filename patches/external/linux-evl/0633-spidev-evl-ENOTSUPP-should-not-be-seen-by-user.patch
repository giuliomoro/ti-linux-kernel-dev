From c5f75af4a83863452c520c05a3b4e14423a248ae Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Sun, 12 Apr 2020 21:37:15 +0200
Subject: [PATCH 0633/1010] spidev: evl: -ENOTSUPP should not be seen by user

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 drivers/spi/spidev.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/spi/spidev.c b/drivers/spi/spidev.c
index 9b199de372..125f03f39a 100644
--- a/drivers/spi/spidev.c
+++ b/drivers/spi/spidev.c
@@ -403,7 +403,7 @@ static int enable_oob_mode(struct spidev_data *spidev,
 out:
 	evl_up(&spidev->oob.sem);
 
-	return ret;
+	return ret == -ENOTSUPP ? -EOPNOTSUPP : ret;
 }
 
 static int disable_oob_mode(struct spidev_data *spidev)
-- 
