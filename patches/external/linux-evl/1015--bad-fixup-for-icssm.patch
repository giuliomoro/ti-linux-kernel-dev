 }
 
-static void pru_spin_lock(struct node_tbl *nt)
-{
-	while (1) {
-		nt->nt_info->arm_lock = 1;
-		if (!nt->nt_info->fw_lock)
-			break;
-		nt->nt_info->arm_lock = 0;
-	}
-}
-
-static inline void pru_spin_unlock(struct node_tbl *nt)
-{
-	nt->nt_info->arm_lock = 0;
-}
-
 int icssm_prueth_lre_nt_insert(struct prueth *prueth,
 			       u8 *mac, int port, int sv_frame, int proto)
 {
@@ -146,7 +131,6 @@ int icssm_prueth_lre_nt_insert(struct prueth *prueth,
 	if (!q)
 		return ret;
 
-	spin_lock_irqsave(&prueth->nt_lock, flags);
 	if (q->full) {
 		ret = LRE_ERR;
 	} else {
@@ -160,7 +144,6 @@ int icssm_prueth_lre_nt_insert(struct prueth *prueth,
 		if (q->wr_ind == q->rd_ind)
 			q->full = true;
 	}
-	spin_unlock_irqrestore(&prueth->nt_lock, flags);
 
 	return ret;
 }
@@ -350,7 +333,6 @@ static void move_up(u16 start, u16 end, struct node_tbl *nt,
 {
 	u16 j = end;
 
-	pru_spin_lock(nt);
 
 	for (; j < start; j++)
 		memcpy(&nt->bin_array->bin_tbl[j],
@@ -369,7 +351,6 @@ static void move_up(u16 start, u16 end, struct node_tbl *nt,
 	if (update)
 		update_indexes(end, start, nt);
 
-	pru_spin_unlock(nt);
 }
 
 /* start < end */
@@ -378,7 +359,6 @@ static void move_down(u16 start, u16 end, struct node_tbl *nt,
 {
 	u16 j = end;
 
-	pru_spin_lock(nt);
 
 	for (; j > start; j--)
 		memcpy(&nt->bin_array->bin_tbl[j],
@@ -391,7 +371,6 @@ static void move_down(u16 start, u16 end, struct node_tbl *nt,
 	if (update)
 		update_indexes(start + 1, end, nt);
 
-	pru_spin_unlock(nt);
 }
 
 static int node_table_insert_from_queue(struct node_tbl *nt,
@@ -547,7 +526,7 @@ static void node_table_check_and_remove(struct node_tbl *nt, u16 forget_time)
 	}
 }
 
-static int pop_queue(struct prueth *prueth, spinlock_t *lock)
+static int pop_queue(struct prueth *prueth)
 {
 	unsigned long flags;
 	struct node_tbl *nt = prueth->nt;
@@ -555,27 +534,23 @@ static int pop_queue(struct prueth *prueth, spinlock_t *lock)
 	struct nt_queue_entry one_mac;
 	int ret = 0;
 
-	spin_lock_irqsave(lock, flags);
 	if (!q->full && q->wr_ind == q->rd_ind) { /* queue empty */
 		ret = 1;
 	} else {
 		memcpy(&one_mac, &q->nt_queue[q->rd_ind],
 		       sizeof(struct nt_queue_entry));
-		spin_unlock_irqrestore(lock, flags);
 		node_table_insert_from_queue(nt, &one_mac);
-		spin_lock_irqsave(lock, flags);
 		q->rd_ind++;
 		q->rd_ind &= (PRUETH_MAC_QUEUE_MAX - 1);
 		q->full = false;
 	}
-	spin_unlock_irqrestore(lock, flags);
 
 	return ret;
 }
 
-static void pop_queue_process(struct prueth *prueth, spinlock_t *lock)
+static void pop_queue_process(struct prueth *prueth)
 {
-	while (pop_queue(prueth, lock) == 0)
+	while (pop_queue(prueth) == 0)
 		;
 }
 
