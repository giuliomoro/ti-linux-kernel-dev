From dd94bb6797a8ae11f9c06081985dec1840e4cbf3 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Sat, 1 Apr 2023 19:54:17 +0200
Subject: [PATCH 0813/1013] evl/net: socket: drop obsolete refcounting

This interface was dropped during the v6.3 development cycle.

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 kernel/evl/net/socket.c | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/kernel/evl/net/socket.c b/kernel/evl/net/socket.c
index 38946d24b2ab..74c7a17511a7 100644
--- a/kernel/evl/net/socket.c
+++ b/kernel/evl/net/socket.c
@@ -765,8 +765,6 @@ static void destroy_evl_socket(struct sock *sk)
 	local_bh_disable();
 	sock_prot_inuse_add(sock_net(sk), sk->sk_prot, -1);
 	local_bh_enable();
-
-	sk_refcnt_debug_dec(sk);
 }
 
 static int create_evl_socket(struct net *net, struct socket *sock,
@@ -791,7 +789,6 @@ static int create_evl_socket(struct net *net, struct socket *sock,
 	 * attached to the out-of-band core in sock_oob_attach().
 	 */
 	sk->sk_protocol = protocol;
-	sk_refcnt_debug_inc(sk);
 	sk->sk_destruct	= destroy_evl_socket;
 
 	local_bh_disable();
-- 
2.30.2

