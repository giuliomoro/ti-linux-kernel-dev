index 000000000..0c3908e64
--- /dev/null
+++ b/drivers/xenomai/net/stack/packet/af_packet.c
@@ -0,0 +1,660 @@
+/***
+ *
+ *  packet/af_packet.c
+ *
+ *  RTnet - real-time networking subsystem
+ *  Copyright (C) 2003-2006 Jan Kiszka <jan.kiszka@web.de>
