diff --git a/arch/arm64/xenomai/include/asm/xenomai/uapi/fptest.h b/arch/arm64/xenomai/include/asm/xenomai/uapi/fptest.h
new file mode 100644
index 000000000..7a2cb925d
--- /dev/null
+++ b/arch/arm64/xenomai/include/asm/xenomai/uapi/fptest.h
@@ -0,0 +1,105 @@
+/*
