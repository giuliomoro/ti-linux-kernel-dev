Date: Wed, 18 Feb 2026 17:37:50 +0000
Subject: [PATCH] bad fixup for icssm

---
 drivers/net/ethernet/ti/icssm/icssm_prueth.c  | 29 +-------------
 drivers/net/ethernet/ti/icssm/icssm_prueth.h  |  6 ---
 .../net/ethernet/ti/icssm/icssm_prueth_lre.c  | 39 ++-----------------
 .../ethernet/ti/icssm/icssm_prueth_switch.c   | 23 -----------
 4 files changed, 5 insertions(+), 92 deletions(-)

diff --git a/drivers/net/ethernet/ti/icssm/icssm_prueth.c b/drivers/net/ethernet/ti/icssm/icssm_prueth.c
index 42a9a063ab2a..5be582c77968 100644
--- a/drivers/net/ethernet/ti/icssm/icssm_prueth.c
+++ b/drivers/net/ethernet/ti/icssm/icssm_prueth.c
@@ -556,7 +556,6 @@ static void icssm_emac_adjust_link(struct net_device *ndev)
 	u32 txcfg, mask;
 	u32 delay;
 
-	spin_lock_irqsave(&emac->lock, flags);
 
 	if (phydev->link) {
 		/* check the mode of operation */
@@ -613,7 +612,6 @@ static void icssm_emac_adjust_link(struct net_device *ndev)
 			netif_stop_queue(ndev);
 	}
 
-	spin_unlock_irqrestore(&emac->lock, flags);
 }
 
 static unsigned int
@@ -721,7 +719,6 @@ static int icssm_prueth_ptp_tx_ts_enqueue(struct prueth_emac *emac,
 		return -EINVAL;
 	}
 
-	spin_lock_irqsave(&emac->ptp_skb_lock, flags);
 	if (emac->ptp_skb[event]) {
 		dev_consume_skb_any(emac->ptp_skb[event]);
 		icssm_prueth_ptp_tx_ts_reset(emac, event);
@@ -730,7 +727,6 @@ static int icssm_prueth_ptp_tx_ts_enqueue(struct prueth_emac *emac,
 
 	skb_get(skb);
 	emac->ptp_skb[event] = skb;
-	spin_unlock_irqrestore(&emac->ptp_skb_lock, flags);
 
 	return 0;
 }
@@ -810,7 +806,6 @@ static void icssm_prueth_ptp_tx_ts_get(struct prueth_emac *emac, u8 event)
 	u64 ns;
 
 	/* get the msg from list */
-	spin_lock_irqsave(&emac->ptp_skb_lock, flags);
 	skb = emac->ptp_skb[event];
 	emac->ptp_skb[event] = NULL;
 	if (!skb) {
@@ -822,7 +817,6 @@ static void icssm_prueth_ptp_tx_ts_get(struct prueth_emac *emac, u8 event)
 		emac->ptp_ct_skb[event] = NULL;
 		ct_ts = true;
 	}
-	spin_unlock_irqrestore(&emac->ptp_skb_lock, flags);
 	if (!skb) {
 		/* TS for cut throguh packet might have already
 		 * be read by emac_rx_packet()
@@ -1280,7 +1274,6 @@ static int icssm_prueth_hsr_ptp_ct_tx_ts_enqueue(struct prueth_emac *emac,
 	}
 
 	/* Store the skb so that tx irq handler will populate the ts */
-	spin_lock_irqsave(&other_emac->ptp_skb_lock, flags);
 	if (other_emac->ptp_ct_skb[event]) {
 		netdev_warn(other_emac->ndev,
 			    "Dropped cut through event waiting for tx ts.\n");
@@ -1289,7 +1282,6 @@ static int icssm_prueth_hsr_ptp_ct_tx_ts_enqueue(struct prueth_emac *emac,
 	}
 
 	other_emac->ptp_ct_skb[event] = skb;
-	spin_unlock_irqrestore(&other_emac->ptp_skb_lock, flags);
 
 	return -EAGAIN;
 }
@@ -2177,18 +2169,11 @@ static enum netdev_tx icssm_emac_ndo_start_xmit(struct sk_buff *skb,
 	struct prueth_emac *emac = netdev_priv(ndev);
 	int ret;
 	u16 qid;
-	void *lock_queue;
 
 	qid = icssm_prueth_get_tx_queue_id(emac->prueth, skb);
 	/* Initialization of spin locks for locking and unlocking Tx Queues */
-	if (PRUETH_IS_LRE(emac->prueth))
-		lock_queue = &emac->prueth->lre_host_queue_lock[qid - 2];
-	else
-		lock_queue = &emac->host_queue_lock[qid];
 
-	raw_spin_lock(lock_queue);
 	ret = icssm_prueth_tx_enqueue(emac, skb, qid);
-	raw_spin_unlock(lock_queue);
 	if (ret) {
 		if (ret != -ENOBUFS && netif_msg_tx_err(emac) &&
 		    net_ratelimit())
@@ -2511,7 +2496,6 @@ static void icssm_emac_ndo_set_rx_mode(struct net_device *ndev)
 	}
 
 	/* for LRE, it is a shared table. So lock the access */
-	spin_lock_irqsave(&emac->addr_lock, flags);
 
 	/* Disable and reset multicast filter, allows allmulti */
 	icssm_emac_mc_filter_ctrl(emac, false);
@@ -2567,7 +2551,7 @@ static void icssm_emac_ndo_set_rx_mode(struct net_device *ndev)
 	}
 
 unlock:
-	spin_unlock_irqrestore(&emac->addr_lock, flags);
+	;
 }
 
 static int icssm_emac_hwtstamp_config_set(struct net_device *ndev,
@@ -2654,7 +2638,6 @@ int icssm_emac_add_del_vid(struct prueth_emac *emac,
 		return 0;
 
 	/* for LRE, it is a shared table. So lock the access */
-	spin_lock_irqsave(&emac->addr_lock, flags);
 
 	/* VLAN filter table is 512 bytes (4096 bit) bitmap.
 	 * Each bit controls enabling or disabling corresponding
@@ -2672,7 +2655,6 @@ int icssm_emac_add_del_vid(struct prueth_emac *emac,
 		val &= ~BIT(bit_index);
 	writeb(val, ram + vlan_filter_tbl + byte_index);
 
-	spin_unlock_irqrestore(&emac->addr_lock, flags);
 
 	netdev_dbg(emac->ndev, "%s VID bit at byte index %d and bit %d\n",
 		   add ? "Setting" : "Clearing", byte_index, bit_index);
@@ -2929,15 +2911,8 @@ static int icssm_prueth_netdev_init(struct prueth *prueth,
 		dev_err(prueth->dev, "could not get ptp tx irq. Skipping PTP support\n");
 	}
 
-	spin_lock_init(&emac->lock);
-	spin_lock_init(&emac->ptp_skb_lock);
-	spin_lock_init(&emac->addr_lock);
 
 	/* Added for HSR PRP Tx optimization */
-	raw_spin_lock_init(&emac->host_queue_lock[0]);
-	raw_spin_lock_init(&emac->host_queue_lock[1]);
-	raw_spin_lock_init(&emac->host_queue_lock[2]);
-	raw_spin_lock_init(&emac->host_queue_lock[3]);
 
 	/* get mac address from DT and set private and netdev addr */
 	ret = of_get_ethdev_address(eth_node, ndev);
@@ -3443,8 +3418,6 @@ static int icssm_prueth_probe(struct platform_device *pdev)
 	}
 	prueth->support_lre = has_lre;
 	/* Added for HSR PRP Tx optimization */
-	raw_spin_lock_init(&prueth->lre_host_queue_lock[0]);
-	raw_spin_lock_init(&prueth->lre_host_queue_lock[1]);
 	/* setup netdev interfaces */
 	if (eth0_node) {
 		ret = icssm_prueth_netdev_init(prueth, eth0_node);
diff --git a/drivers/net/ethernet/ti/icssm/icssm_prueth.h b/drivers/net/ethernet/ti/icssm/icssm_prueth.h
index 849f655051c4..a7e42fd40019 100644
--- a/drivers/net/ethernet/ti/icssm/icssm_prueth.h
+++ b/drivers/net/ethernet/ti/icssm/icssm_prueth.h
@@ -438,8 +438,6 @@ struct prueth_emac {
 	/* spin lock used to protect
 	 * during link configuration
 	 */
-	spinlock_t lock;
