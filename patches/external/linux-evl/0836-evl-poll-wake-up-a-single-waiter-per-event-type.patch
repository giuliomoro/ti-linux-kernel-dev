From bb6f0cafc968f4fb86ba535e8432103d98cff186 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Sat, 25 Nov 2023 11:05:57 +0100
Subject: [PATCH 836/985] evl/poll: wake up a single waiter per event type

To prevent a thundering herd effect, a single waiter should be
unblocked for each distinct incoming event type.

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 kernel/evl/poll.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/kernel/evl/poll.c b/kernel/evl/poll.c
index 0dfc7aca0..b7c4d0caa 100644
--- a/kernel/evl/poll.c
+++ b/kernel/evl/poll.c
@@ -98,6 +98,15 @@ void evl_poll_watch(struct evl_poll_head *head,
 }
 EXPORT_SYMBOL_GPL(evl_poll_watch);
 
+/*
+ * __evl_signal_poll_events - wake up threads polling for events.
+ *
+ * @head	poll head waiters sleep on
+ * @events	incoming events to signal
+ *
+ * A single waiter is unblocked for any distinct event signaled on
+ * entry.
+ */
 void __evl_signal_poll_events(struct evl_poll_head *head,
 			int events)
 {
@@ -115,6 +124,9 @@ void __evl_signal_poll_events(struct evl_poll_head *head,
 		if (ready) {
 			poco->events_received |= ready;
 			evl_raise_flag_nosched(wpt->flag);
+			events &= ~ready;
+			if (!events)
+				break;
 		}
 	}
 
