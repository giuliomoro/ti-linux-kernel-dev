new file mode 100644
index 000000000..d762526b6
--- /dev/null
+++ b/kernel/xenomai/vfile.c
@@ -0,0 +1,999 @@
+/*
+ * Copyright (C) 2010 Philippe Gerum <rpm@xenomai.org>
+ *
