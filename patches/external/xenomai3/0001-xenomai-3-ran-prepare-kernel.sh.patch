+static void ni_handle_eos(struct a4l_subdevice *subd)
+{
+	struct a4l_device *dev = subd->dev;
+
+	if (devpriv->aimode == AIMODE_SCAN) {
+		static const int timeout = 10;
+		int i;
+
+		for (i = 0; i < timeout; i++) {
+			ni_sync_ai_dma(subd);
