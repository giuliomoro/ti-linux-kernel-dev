From 2fa54164ede7aa1bd1d33c0609b05b1a78509273 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <philippe.gerum@exail.com>
Date: Thu, 1 Feb 2024 11:17:47 +0100
Subject: [PATCH 0856/1013] evl/net: socket: make bind, connect handlers
 optional

Signed-off-by: Philippe Gerum <philippe.gerum@exail.com>
---
 include/evl/net/socket.h       |  4 ----
 kernel/evl/net/packet/packet.c |  1 -
 kernel/evl/net/socket.c        | 19 +++++--------------
 3 files changed, 5 insertions(+), 19 deletions(-)

diff --git a/include/evl/net/socket.h b/include/evl/net/socket.h
index 9123209d334e..8b4b5a2739b7 100644
--- a/include/evl/net/socket.h
+++ b/include/evl/net/socket.h
@@ -124,8 +124,4 @@ int evl_charge_socket_wmem(struct evl_socket *esk,
 			struct sk_buff *skb,
 			ktime_t timeout, enum evl_tmode tmode);
 
-int evl_proto_no_connect(struct evl_socket *esk,
-			struct sockaddr *addr,
-			int len, int flags);
-
 #endif /* !_EVL_NET_SOCKET_H */
diff --git a/kernel/evl/net/packet/packet.c b/kernel/evl/net/packet/packet.c
index 6f8bf5f151ad..cd765ea29846 100644
--- a/kernel/evl/net/packet/packet.c
+++ b/kernel/evl/net/packet/packet.c
@@ -661,7 +661,6 @@ static struct evl_net_proto ether_packet_proto = {
 	.attach	= attach_packet_socket,
 	.detach = detach_packet_socket,
 	.bind = bind_packet_socket,
-	.connect = evl_proto_no_connect,
 	.oob_send = send_packet,
 	.oob_poll = poll_packet,
 	.oob_receive = receive_packet,
diff --git a/kernel/evl/net/socket.c b/kernel/evl/net/socket.c
index 445b9dde4e5f..8dd1a2ef1b8b 100644
--- a/kernel/evl/net/socket.c
+++ b/kernel/evl/net/socket.c
@@ -499,10 +499,9 @@ void sock_oob_detach(struct sock *sk)
 
 /*
  * In-band call from the common network stack to complete a binding
- * (@sock is out-of-band capable). We end up here _before_ an attempt
- * is made to bind a socket to the given address by the in-band
- * network stack, so that we can do preliminary EVL-specific binding
- * work.
+ * (@sock is out-of-band capable). We end up here _after_ a successful
+ * binding of the network socket to the given address by the in-band
+ * stack.
  */
 int sock_oob_bind(struct socket *sock, struct sockaddr *addr, int len)
 {
@@ -514,7 +513,7 @@ int sock_oob_bind(struct socket *sock, struct sockaddr *addr, int len)
 	 * for which we have an out-of-band extension
 	 * (e.g. AF_PACKET).
 	 */
-	if (sock->sk->sk_family == PF_OOB)
+	if (sock->sk->sk_family == PF_OOB || !esk->proto->bind)
 		return 0;
 
 	return esk->proto->bind(esk, addr, len);
@@ -536,7 +535,7 @@ int sock_oob_connect(struct socket *sock,
 	 * for which we have an out-of-band extension
 	 * (e.g. AF_INET/IPPROTO_UDP).
 	 */
-	if (sock->sk->sk_family == PF_OOB)
+	if (sock->sk->sk_family == PF_OOB || !esk->proto->connect)
 		return 0;
 
 	return esk->proto->connect(esk, addr, len, flags);
@@ -830,11 +829,3 @@ const struct net_proto_family evl_family_ops = {
 	.create = create_evl_socket,
 	.owner	= THIS_MODULE,
 };
-
-int evl_proto_no_connect(struct evl_socket *esk,
-			struct sockaddr *addr,
-			int len, int flags)
-{
-	return 0;
-}
-EXPORT_SYMBOL_GPL(evl_proto_no_connect);
-- 
2.30.2

