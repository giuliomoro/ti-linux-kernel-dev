+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_GENERIC_EVL_NETDEVICE_H
+#define _ASM_GENERIC_EVL_NETDEVICE_H
+
+#ifdef CONFIG_EVL
+
+#include <linux/list.h>
