From b126ceae9a81387e5dbd1b8f94c7a141907a55d1 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Sat, 1 Feb 2025 12:56:06 +0100
Subject: [PATCH 0933/1010] drivers/evl: latmus: release cdev region on unload

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 drivers/evl/latmus.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/evl/latmus.c b/drivers/evl/latmus.c
index 0e3d744690..c9659dbf73 100644
--- a/drivers/evl/latmus.c
+++ b/drivers/evl/latmus.c
@@ -1231,6 +1231,7 @@ static void __exit latmus_exit(void)
 {
 	device_destroy(&latmus_class, MKDEV(MAJOR(latmus_devt), 0));
 	cdev_del(&latmus_cdev);
+	unregister_chrdev_region(latmus_devt, 1);
 	class_unregister(&latmus_class);
 }
 module_exit(latmus_exit);
