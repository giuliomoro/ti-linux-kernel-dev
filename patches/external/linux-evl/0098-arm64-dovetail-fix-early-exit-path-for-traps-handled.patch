From 0a53961844d643c82f91ac905a3be2a31619f38a Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Sat, 4 Mar 2023 18:55:26 +0100
Subject: [PATCH 0098/1010] arm64: dovetail: fix early exit path for traps
 handled oob

Every call to oob_trap_notify() must be paired with a call to
oob_trap_unwind() to close the trap handling section, even when the
in-band side decides to leave it unhandled because the companion core
did not switch in-band.

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 arch/arm64/include/asm/dovetail.h | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/include/asm/dovetail.h b/arch/arm64/include/asm/dovetail.h
index 9d952ec6f0..f7a672c750 100644
--- a/arch/arm64/include/asm/dovetail.h
+++ b/arch/arm64/include/asm/dovetail.h
@@ -47,10 +47,14 @@ static inline void arch_dovetail_switch_finish(bool enter_inband)
  * Pass the trap event to the companion core. Return true if running
  * in-band afterwards.
  */
-#define mark_cond_trap_entry(__trapnr, __regs)		\
-	({						\
-		oob_trap_notify(__trapnr, __regs);	\
-		running_inband();			\
+#define mark_cond_trap_entry(__trapnr, __regs)			\
+	({							\
+	  	bool __ret;					\
+		oob_trap_notify(__trapnr, __regs);		\
+		__ret = running_inband();			\
+		if (!__ret)					\
+			oob_trap_unwind(__trapnr, __regs);	\
+		__ret;						\
 	})
 
