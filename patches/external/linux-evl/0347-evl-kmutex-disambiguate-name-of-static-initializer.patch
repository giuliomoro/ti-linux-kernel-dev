From 93ae074544a03afe2502123d8d2a7a5158034908 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <rpm@xenomai.org>
Date: Sun, 17 Mar 2019 15:52:51 +0100
Subject: [PATCH 347/985] evl/kmutex: disambiguate name of static initializer

Signed-off-by: Philippe Gerum <rpm@xenomai.org>
---
 include/evl/mutex.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/evl/mutex.h b/include/evl/mutex.h
index 26423fbd2..0284f1ea6 100644
--- a/include/evl/mutex.h
+++ b/include/evl/mutex.h
@@ -104,7 +104,7 @@ struct evl_kmutex {
 			.fastlock = ATOMIC_INIT(0),			\
 	}
 
-#define DEFINE_EVL_MUTEX(__name)					\
+#define DEFINE_EVL_KMUTEX(__name)					\
 	struct evl_kmutex __name = EVL_KMUTEX_INITIALIZER(__name)
 
 static inline
