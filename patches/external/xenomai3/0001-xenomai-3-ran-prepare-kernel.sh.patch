--- /dev/null
+++ b/drivers/xenomai/net/stack/rtcfg/rtcfg_conn_event.c
@@ -0,0 +1,364 @@
+/***
+ *
+ *  rtcfg/rtcfg_conn_event.c
+ *
+ *  Real-Time Configuration Distribution Protocol
