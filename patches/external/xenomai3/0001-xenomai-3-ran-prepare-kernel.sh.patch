+#endif /* CONFIG_XENO_DRIVERS_NET_RTIPV4 */
+
+	announce_rpl->flags = rtcfg_dev->flags & _RTCFG_FLAG_READY;
+	announce_rpl->burstrate = 0; /* padding field */
+
+	return rtcfg_send_frame(rtskb, rtdev, dest_mac_addr);
+}
