diff --git a/include/xenomai/rtdm/analogy/driver.h b/include/xenomai/rtdm/analogy/driver.h
new file mode 100644
index 000000000..08a75464a
--- /dev/null
+++ b/include/xenomai/rtdm/analogy/driver.h
@@ -0,0 +1,74 @@
+/**
