From 642e54b023c45d68ad6b067d6216a2c81749be00 Mon Sep 17 00:00:00 2001
From: Philippe Gerum <philippe.gerum@exail.com>
Date: Thu, 13 Mar 2025 14:21:10 +0100
Subject: [PATCH 0187/1010] irq_work: irq_pipeline: export
 irq_local_work_raise()

Signed-off-by: Philippe Gerum <philippe.gerum@exail.com>
---
 include/linux/irq_work.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/include/linux/irq_work.h b/include/linux/irq_work.h
index 136f2980cb..0c4b9aff87 100644
--- a/include/linux/irq_work.h
+++ b/include/linux/irq_work.h
@@ -67,12 +67,14 @@ void irq_work_run(void);
 bool irq_work_needs_cpu(void);
 void irq_work_single(void *arg);
 
+void irq_local_work_raise(void);
 void arch_irq_work_raise(void);
 
 #else
 static inline bool irq_work_needs_cpu(void) { return false; }
 static inline void irq_work_run(void) { }
 static inline void irq_work_single(void *arg) { }
+static inline void irq_local_work_raise(void) { }
 #endif
 
 #endif /* _LINUX_IRQ_WORK_H */
